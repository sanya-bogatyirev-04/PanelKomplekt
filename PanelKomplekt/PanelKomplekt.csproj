<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PanelKomplekt</RootNamespace>
    <AssemblyName>PanelKomplekt</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Версия A.B.C: A — глобальное обновление, B — изменения для пользователя, C — служебные (Docs/DevelopmentRules.md, п. 9) -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Запись спецификации в Excel (.xlsx). ClosedXML 0.95.4 — последняя версия с отдельной сборкой под .NET Framework 4.6+:
    всего четыре DLL (ClosedXML, DocumentFormat.OpenXml, ExcelNumberFormat, System.IO.Packaging) без пакетов-фасадов netstandard,
    что снижает риск конфликтов с другими плагинами AutoCAD. Лицензия MIT.
  -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.95.4" />
  </ItemGroup>

  <!-- Библиотеки AutoCAD 2021 (локально или из NuGet) -->
  <Import Project="..\AutoCadReferences.props" />

  <!-- Отладка (F5) настроена в Properties/launchSettings.json: запуск AutoCAD 2021 + start.scr -->
  <ItemGroup>
    <None Update="start.scr" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Файл-шаблон блока панели PK_Panel: копируется в bin\<конфигурация>\Blocks, оттуда его читает Core/PanelBlock.cs -->
  <ItemGroup>
    <None Include="Blocks\PK_Panel.dwg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Иконки кнопок ленты: лежат в папках команд, встраиваются в DLL как Icons/<Key>_<размер>.png -->
  <ItemGroup>
    <EmbeddedResource Include="Commands\**\*.png" LogicalName="Icons/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
