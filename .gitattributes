# Окончания строк: в репозитории хранятся LF, в рабочей папке Windows — по типу файла.
* text=auto

# Файлы Windows и Visual Studio — всегда CRLF (.cmd без CRLF может работать неправильно).
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.scr     text eol=crlf
*.lsp     text eol=crlf

# Текст и документация.
*.md      text
*.txt     text
*.xml     text
*.json    text
*.yml     text

# Двоичные файлы — git не должен их изменять и сравнивать построчно.
*.dwg     binary
*.dxf     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.zip     binary
*.dll     binary
