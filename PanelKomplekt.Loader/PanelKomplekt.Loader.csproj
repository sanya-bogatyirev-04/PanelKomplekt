<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Загрузчик плагина для установленной версии (.bundle).
    AutoCAD при запуске загружает этот маленький DLL, а он — основной PanelKomplekt.dll.
    При отладке из Visual Studio (переменная окружения PANELKOMPLEKT_DEV=1) установленная версия не загружается,
    чтобы работала свежая сборка из bin\Debug.
  -->
  <PropertyGroup>
    <!-- Те же две сборки, что у основного проекта: net48 — AutoCAD 2021–2024, net47 — AutoCAD 2020 -->
    <TargetFrameworks>net48;net47</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PanelKomplekt.Loader</RootNamespace>
    <AssemblyName>PanelKomplekt.Loader</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Библиотеки AutoCAD своей версии для каждой сборки (локально или из NuGet) -->
  <Import Project="..\AutoCadReferences.props" />

</Project>
