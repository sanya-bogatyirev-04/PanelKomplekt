# Единые настройки редактора для VS 2022
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
# UTF-8 с BOM — чтобы русские комментарии гарантированно корректно читались любыми инструментами
charset = utf-8-bom

[*.{csproj,props,targets,xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
